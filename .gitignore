.gradle/
**/.gradle/
/build/
benchmark/**/build/
.m2/

# Unignore source code folders that might be named build
!src/**/build/
!src/**/build/**

# ── Graphify (keep main knowledge graph, ignore cache & date backups) ──
graphify-out/cache/
graphify-out/[0-9]*/

# ── Proyectos de demo / sandbox locales ───────────────────────
demo_app/
javafx_demo/
*_sandbox/
test_*/

